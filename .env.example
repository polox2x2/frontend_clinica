# Copia este archivo a .env y ajusta los valores. NUNCA commitees el .env real.

# URL base de la API del backend (se hornea en el build de Vite).
# En local apunta al backend local; en produccion, al dominio del backend.
VITE_API_URL=http://localhost:8080/api
# Ejemplo produccion:
# VITE_API_URL=https://medicitas-api.lmart.dev/api

# Opcional; si se omite se deriva de VITE_API_URL como ws(s)://host/ws.
# VITE_WS_URL=ws://localhost:8080/ws

# --- Imagen / registro (para docker-compose local) ---
GITHUB_REPOSITORY=polox2x2/frontend_clinica
TAG=latest
